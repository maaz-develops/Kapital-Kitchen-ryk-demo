# ==============================================================================
# KAPITAL KITCHEN — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your deployment secrets.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# Application URL
APP_URL=https://your-domain.example

# Security & Session Authentication
# Provide a strong random 256-bit secret string (e.g. `openssl rand -hex 32`)
AUTH_SECRET=your_auth_secret_minimum_32_characters_here

# Admin Credentials Setup
# Default initial admin username:
ADMIN_USERNAME=your_admin_username
# Pre-computed bcrypt hash of your chosen admin password (never plaintext!):
ADMIN_PASSWORD_HASH=replace_with_generated_bcrypt_hash

# CORS Allowed Origins
# Comma-separated list of allowed production client origins
CORS_ORIGIN=https://your-domain.example

# Optional Database (MongoDB Atlas Free Tier)
# Leave empty for default memory store, or provide MongoDB URI:
MONGODB_URI=your_mongodb_connection_string
